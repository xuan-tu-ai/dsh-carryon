{
  "name": "dsh-carryon",
  "version": "0.0.1",
  "description": "CarryOn context folding as a compaction plugin for DeepSeek Harness (experimental)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuan-tu-ai/dsh-carryon.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "prompts/*.md",
    "cordis.patch.yml",
    "web-preset.patch.yml",
    "web-default.patch.yml"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-alpha.2 <0.2.3"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./web-preset.patch.yml",
        "./web-default.patch.yml"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts test/*.test.mjs",
    "gen:web-preset": "node scripts/gen-web-preset.mjs",
    "check:web-preset": "node scripts/gen-web-preset.mjs --check",
    "sync:carrycode": "node scripts/sync-carrycode.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.2-alpha.2",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
