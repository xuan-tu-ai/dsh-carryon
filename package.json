{
  "name": "dsh-carryon",
  "version": "0.1.0",
  "description": "CarryOn context folding (arXiv:2610.18784) as a compaction plugin for DeepSeek Harness (experimental)",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "compaction",
    "context-folding",
    "carryon",
    "coding-agent",
    "llm"
  ],
  "homepage": "https://github.com/xuan-tu-ai/dsh-carryon#readme",
  "bugs": {
    "url": "https://github.com/xuan-tu-ai/dsh-carryon/issues"
  },
  "license": "Apache-2.0",
  "author": "xuan-tu-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuan-tu-ai/dsh-carryon.git"
  },
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "prompts/*.md",
    "cordis.patch.yml",
    "web-preset.patch.yml",
    "web-default.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-alpha.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./web-preset.patch.yml",
        "./web-default.patch.yml"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts test/*.test.mjs",
    "gen:web-preset": "node scripts/gen-web-preset.mjs",
    "check:web-preset": "node scripts/gen-web-preset.mjs --check",
    "sync:carrycode": "node scripts/sync-carrycode.mjs",
    "prepack": "pnpm -s build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-token-meter": "0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-token-meter": "0.2.2-alpha.3",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
